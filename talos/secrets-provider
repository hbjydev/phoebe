#!/usr/bin/env bash
set -euo pipefail

script_dir="$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)"

case "${1:-}:${2:-}" in
  secrets:get)
    exec op inject --in-file "$script_dir/secrets.yaml.optpl"
    ;;
  secrets:put)
    echo "refusing to replace the 1Password-managed Talos secrets bundle" >&2
    exit 1
    ;;
  *)
    echo "usage: $0 secrets {get|put} <cluster-name>" >&2
    exit 2
    ;;
esac
