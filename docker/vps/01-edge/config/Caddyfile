{
	email {$CADDY_ACME_EMAIL}
	http_port 80
	https_port 443

	servers :443 {
		listener_wrappers {
			proxy_protocol {
				timeout 2s
				allow 127.0.0.1/32
			}
			tls
		}
	}
	servers :80 {
		listener_wrappers {
			proxy_protocol {
				timeout 2s
				allow 127.0.0.1/32
			}
		}
	}

	log default {
		output stdout
		format json
	}
}

doco-cd.hayden.moe {
	log
	reverse_proxy doco-cd:80
}

www.hayden.moe {
	log
	redir https://hayden.moe{uri} permanent
}

hayden.moe {
  log

	# Matrix .well-known — proxy to the matrix subdomain (federation clients don't follow 3xx).
	@matrix path /.well-known/matrix/*
	handle @matrix {
    header {
      Access-Control-Allow-Origin "*"
    }
		reverse_proxy https://matrix.hayden.moe
	}

	# GoToSocial .well-known — proxy to the gts subdomain
	@gts path /.well-known/webfinger
	handle @gts {
    header {
      Access-Control-Allow-Origin "*"
    }
		reverse_proxy https://gts.hayden.moe
	}

	# Everything else → anubis bot-challenge; anubis forwards non-challenge
	# traffic back to caddy:8082 which passes it through to the S3 website.
	reverse_proxy anubis:8083 {
		header_up X-Real-Ip {client_ip}
	}
}

:8082 {
	log

	@trailing_slash path */
	rewrite @trailing_slash {path}index.html

	# Skip rewrite if the request already ends in index.html to prevent infinite loops
	@not_index {
		not path */index.html
	}

	reverse_proxy @not_index https://s3.hayden.moe {
		header_up Host hayden.moe
		header_up X-Forwarded-Host {host}

    @s3_error status 403 404
    handle_response @s3_error {
      rewrite * {path}/index.html

      reverse_proxy https://s3.hayden.moe {
				header_up Host hayden.moe
				header_up X-Forwarded-Host {host}
      }
    }
	}

	reverse_proxy https://s3.hayden.moe {
		header_up Host hayden.moe
		header_up X-Forwarded-Host {host}
	}
}
